<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only for the update check (a plain file from GitHub) and the update's download – the pictures are in the app. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${label}"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Ten more pictures of the planet, to download in several sizes. -->
        <activity
            android:name=".PicturesActivity"
            android:exported="false"
            android:label="${label}" />

        <!-- Android's installer reports here how an update went (and asks to confirm it). -->
        <receiver
            android:name="dev.hearth.launcher.wallpaper.WallpaperUpdateReceiver"
            android:exported="false" />

        <service
            android:name=".SceneWallpaperService"
            android:exported="true"
            android:label="${label}"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>
    </application>
</manifest>
