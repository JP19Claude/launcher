#!/usr/bin/env bash
# ZENITH für Arch Linux – die Android-App läuft in Waydroid (Android in einem Container, mit Fenstern unter Wayland).
#
#   zenith-arch install   Waydroid einrichten (falls nötig), ZENITH holen und installieren, als Startbildschirm setzen
#   zenith-arch start     Waydroid starten und ZENITH zeigen
#   zenith-arch update    die neueste ZENITH-Version holen und über die alte installieren (Daten bleiben)
#   zenith-arch stop      Waydroid beenden
#   zenith-arch status    zeigt, was schon eingerichtet ist
#   zenith-arch remove    ZENITH aus Waydroid entfernen
#
# Eine Variable: ZENITH_GAPPS=1 richtet Waydroid mit Google-Diensten ein (ZENITH braucht sie nicht).
set -euo pipefail

REPO="JP19Claude/launcher"
APK_URL="https://github.com/${REPO}/releases/latest/download/ZENITH.apk"
PKG="dev.hearth.launcher"
HOME_ACTIVITY="${PKG}/${PKG}.MainActivity"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/zenith-arch"

say()  { printf '\033[1;35m▸\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m✓\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# --- Voraussetzungen -----------------------------------------------------------------------------------------------

check_system() {
  [ -r /etc/arch-release ] || warn "Das ist kein Arch Linux (keine /etc/arch-release) – es sollte trotzdem gehen, die Paketnamen können abweichen."
  have curl || die "curl fehlt: sudo pacman -S curl"
  have sudo || die "sudo fehlt: sudo pacman -S sudo (oder als root ausführen und sudo-Aufrufe weglassen)"
  if [ "${XDG_SESSION_TYPE:-}" != "wayland" ]; then
    warn "Du bist nicht in einer Wayland-Sitzung (XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-leer}). Waydroid zeigt seine Fenster nur unter Wayland"
    warn "(GNOME, KDE Plasma, Hyprland, Sway …). Unter X11 hilft 'cage' oder 'weston': Wayland-Compositor in einem Fenster, darin 'zenith-arch start'."
  fi
}

# Waydroid braucht den "binder" des Kernels (Linux-Zen und die meisten neuen Arch-Kernel haben ihn; sonst binder_linux-dkms aus dem AUR).
check_binder() {
  if grep -qw binder /proc/filesystems 2>/dev/null; then return 0; fi
  say "Der Kernel zeigt keinen 'binder' – ich versuche, das Modul zu laden …"
  sudo modprobe binder_linux devices="binder,hwbinder,vndbinder" 2>/dev/null || true
  if grep -qw binder /proc/filesystems 2>/dev/null; then ok "binder ist da."; return 0; fi
  die "Dein Kernel hat keinen binder. Entweder den Kernel linux-zen nehmen (sudo pacman -S linux-zen linux-zen-headers, dann damit neu starten) oder binder_linux-dkms aus dem AUR bauen (mit den Headers deines Kernels)."
}

install_waydroid() {
  if have waydroid; then ok "Waydroid ist schon installiert."; return 0; fi
  say "Installiere Waydroid …"
  if pacman -Si waydroid >/dev/null 2>&1; then
    sudo pacman -S --needed --noconfirm waydroid
  elif have paru; then
    paru -S --needed waydroid
  elif have yay; then
    yay -S --needed waydroid
  else
    die "Waydroid ist nicht in deinen Paketquellen. Installiere es aus dem AUR (https://aur.archlinux.org/packages/waydroid, z. B. mit yay oder paru) und starte dann 'zenith-arch install' noch einmal."
  fi
  # Das Netzwerk von Waydroid braucht dnsmasq und nftables.
  sudo pacman -S --needed --noconfirm dnsmasq nftables 2>/dev/null || warn "dnsmasq/nftables konnten nicht installiert werden – ohne sie hat Android kein Netzwerk."
}

init_waydroid() {
  if [ -f /var/lib/waydroid/waydroid.cfg ]; then ok "Waydroid ist schon eingerichtet."; else
    say "Richte Waydroid ein (lädt das Android-Abbild, etwa 1 GB – das dauert) …"
    if [ "${ZENITH_GAPPS:-0}" = "1" ]; then sudo waydroid init -s GAPPS -f; else sudo waydroid init; fi
  fi
  sudo systemctl enable --now waydroid-container
}

# --- Sitzung ---------------------------------------------------------------------------------------------------------

session_running() { waydroid status 2>/dev/null | grep -Eq 'Session:[[:space:]]+RUNNING'; }

start_session() {
  if session_running; then return 0; fi
  mkdir -p "$CACHE"
  say "Starte die Waydroid-Sitzung …"
  nohup waydroid session start >"$CACHE/session.log" 2>&1 &
  for _ in $(seq 1 90); do
    session_running && { ok "Android läuft."; return 0; }
    sleep 1
  done
  die "Die Sitzung startete nicht innerhalb von 90 Sekunden. Siehe $CACHE/session.log und 'sudo journalctl -u waydroid-container'."
}

# --- ZENITH ----------------------------------------------------------------------------------------------------------

fetch_apk() {
  mkdir -p "$CACHE"
  say "Lade die neueste ZENITH.apk (${APK_URL}) …"
  curl -fL --progress-bar -o "$CACHE/ZENITH.apk.part" "$APK_URL"
  mv "$CACHE/ZENITH.apk.part" "$CACHE/ZENITH.apk"
  ok "ZENITH.apk geladen ($(du -h "$CACHE/ZENITH.apk" | cut -f1))."
}

install_apk() {
  say "Installiere ZENITH in Waydroid …"
  waydroid app install "$CACHE/ZENITH.apk"
  ok "ZENITH ist installiert."
}

# ZENITH als Startbildschirm von Waydroid (statt Lineages Launcher).
set_home() {
  say "Setze ZENITH als Startbildschirm …"
  if sudo waydroid shell cmd package set-home-activity "$HOME_ACTIVITY" >/dev/null 2>&1 \
    || sudo waydroid shell -- cmd package set-home-activity "$HOME_ACTIVITY" >/dev/null 2>&1; then
    ok "ZENITH ist der Startbildschirm."
  else
    warn "Das Setzen ging nicht von hier aus. In Android: Einstellungen → Apps → Standard-Apps → Start-App → ZENITH."
  fi
}

show_ui() {
  say "Zeige die Android-Oberfläche (ZENITH) …"
  waydroid show-full-ui >/dev/null 2>&1 &
  sleep 2
  waydroid app launch "$PKG" >/dev/null 2>&1 || true
}

# --- Befehle ---------------------------------------------------------------------------------------------------------

cmd_install() {
  check_system
  install_waydroid
  check_binder
  init_waydroid
  start_session
  fetch_apk
  install_apk
  set_home
  show_ui
  ok "Fertig. Später: 'zenith-arch start'. Bei der ersten Benutzung in ZENITH: „Zugriff auf alle Dateien“ erlauben, damit das Glas dein Hintergrundbild zeigt."
}

cmd_start() {
  have waydroid || die "Waydroid fehlt – erst 'zenith-arch install'."
  start_session
  show_ui
}

cmd_update() {
  have waydroid || die "Waydroid fehlt – erst 'zenith-arch install'."
  start_session
  fetch_apk
  install_apk
}

cmd_stop() {
  have waydroid || exit 0
  waydroid session stop || true
  ok "Waydroid beendet."
}

cmd_status() {
  if have waydroid; then ok "Waydroid: installiert"; else warn "Waydroid: nicht installiert"; fi
  if grep -qw binder /proc/filesystems 2>/dev/null; then ok "Kernel: binder vorhanden"; else warn "Kernel: kein binder"; fi
  [ -f /var/lib/waydroid/waydroid.cfg ] && ok "Waydroid: eingerichtet" || warn "Waydroid: noch nicht eingerichtet (sudo waydroid init)"
  if have waydroid && session_running; then
    ok "Sitzung: läuft"
    waydroid app list 2>/dev/null | grep -qi "$PKG" && ok "ZENITH: installiert" || warn "ZENITH: nicht installiert"
  else
    warn "Sitzung: läuft nicht"
  fi
  echo "Wayland: ${XDG_SESSION_TYPE:-?}"
}

cmd_remove() {
  have waydroid || die "Waydroid fehlt."
  start_session
  waydroid app remove "$PKG" && ok "ZENITH ist aus Waydroid entfernt."
}

case "${1:-help}" in
  install) cmd_install ;;
  start)   cmd_start ;;
  update)  cmd_update ;;
  stop)    cmd_stop ;;
  status)  cmd_status ;;
  remove)  cmd_remove ;;
  *)       sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
