<?xml version="1.0" encoding="utf-8"?>
<!-- Hearth One: Hearth with Glimmer (the island) and Clawd (his widgets and screen) built in,
     one app instead of three. Hearth's package, so it installs over Hearth as an update. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <!-- Claude in the system: talking to Claude, setting alarms and timers without a detour,
         finding contacts by name (asked for only when Claude needs it) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <queries>
        <!-- What Claude opens for you -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.speech.tts.engine.CHECK_TTS_DATA" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
    </queries>


    <!-- Earbuds' battery level in the island (Android 12+ asks the user once). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- New screenshots as a little picture in the island (asked in the Glimmer app). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:replace="android:maxSdkVersion" />

    <!-- Lets the app ask once not to be put to sleep, so its service survives standby. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Glimmer Drop: two phones held together find each other (Bluetooth beacon) and share
         over a fast direct connection (Bluetooth and Wi-Fi Direct). Google's Nearby needs
         location access to look for the other phone, on every Android version. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Only to feel a phone held against this one – never for location (without this flag
         Android 12+ hands Bluetooth scan results only to apps with location access). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        tools:remove="android:maxSdkVersion" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:remove="android:maxSdkVersion" />

    <!-- Glimmer Drop: "über Quick Share senden" looks for Quick Share among the share targets. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND_MULTIPLE" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application>
        <!-- Glimmer Drop: hold two phones together and share; also in Android's share sheet. -->
        <activity
            android:name=".DropActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Glimmer Drop"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Hearth-Einstellungen" as an app of its own: on the home screen and in the app
             drawer (of any launcher), it opens Hearth's settings. -->
        <activity
            android:name=".SettingsShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@mipmap/ic_settings_app"
            android:label="ZENITH-Einstellungen"
            android:noHistory="true"
            android:roundIcon="@mipmap/ic_settings_app"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Claude over any app. ASSIST: Hearth can be the phone's digital assistant (long
             press on home). Questions only come in through the alias below. -->
        <activity
            android:name=".ClaudeAssistActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="Claude"
            android:launchMode="singleTask"
            android:taskAffinity="dev.hearth.launcher.claude"
            android:theme="@style/Theme.Hearth.Assist"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The door for questions: only the family's apps (same signature) may use it. -->
        <activity-alias
            android:name=".ClaudeAskActivity"
            android:exported="true"
            android:permission="dev.hearth.permission.BRIDGE"
            android:targetActivity=".ClaudeAssistActivity" />

        <!-- App lock: asks for the phone's PIN or biometrics before a locked app shows. Only the
             family's apps may open it (Hearth itself, and Glimmer when it sees a locked app). -->
        <activity
            android:name=".AppLockActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:permission="dev.hearth.permission.BRIDGE"
            android:taskAffinity="dev.hearth.launcher.lock"
            android:theme="@style/Theme.Hearth" />

        <!-- "Claude" tile in the system's quick settings -->
        <service
            android:name=".system.ClaudeTileService"
            android:exported="true"
            android:icon="@drawable/ic_claude_spark"
            android:label="Claude"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Glimmer, built in -->
        <activity
            android:name=".GlimmerActivity"
            android:exported="false"
            android:label="Glimmer"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <!-- The island over every app, the Face ID moment, lock screen notifications. -->
        <service
            android:name=".system.GlimmerService"
            android:exported="true"
            android:label="@string/glimmer_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/glimmer_service" />
        </service>

        <!-- The family's bridge (signature-protected); inside Hearth One calls go straight. -->
        <provider
            android:name=".system.GlimmerBridgeProvider"
            android:authorities="dev.hearth.launcher.bridge"
            android:exported="true"
            android:permission="dev.hearth.permission.BRIDGE" />

        <!-- Clawd, built in -->
        <activity
            android:name=".clawd.ClawdAppActivity"
            android:exported="false"
            android:label="Clawd"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

