<?xml version="1.0" encoding="utf-8"?>
<!-- Kontrollzentrum: the glass control center over every app, replacing One UI's on request.
     Works with any launcher; Hearth hands it the look of its own control center. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".ControlsActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The control center over any app (swipe down over the status bar). -->
        <service
            android:name=".system.ControlCenterService"
            android:exported="true"
            android:label="@string/control_center_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/control_center_service" />
        </service>

        <!-- Hearth hands over its look and asks for system actions through this (signature-protected). -->
        <provider
            android:name=".system.GlimmerBridgeProvider"
            android:authorities="dev.hearth.controls.bridge"
            android:exported="true"
            android:permission="dev.hearth.permission.BRIDGE" />
    </application>
</manifest>
