<?xml version="1.0" encoding="utf-8"?>
<!-- Glimmer: the island around the camera, Face ID moment, always-on display, lock screen
     notifications. Works with any launcher; with Hearth, apps fly into it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Earbuds' battery level in the island (Android 12+ asks the user once). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Lets the app ask once not to be put to sleep, so its service survives standby. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application>
        <activity
            android:name=".GlimmerActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The island over every app, the Face ID moment, lock screen notifications. -->
        <service
            android:name=".system.GlimmerService"
            android:exported="true"
            android:label="@string/glimmer_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/glimmer_service" />
        </service>

        <!-- Hearth asks Glimmer through this (signature-protected). -->
        <provider
            android:name=".system.GlimmerBridgeProvider"
            android:authorities="dev.hearth.glimmer.bridge"
            android:exported="true"
            android:permission="dev.hearth.permission.BRIDGE" />
    </application>
</manifest>
