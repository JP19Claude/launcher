<?xml version="1.0" encoding="utf-8"?>
<!-- Glimmer: the island around the camera, Face ID moment, always-on display, lock screen
     notifications. Works with any launcher; with Hearth, apps fly into it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Earbuds' battery level in the island (Android 12+ asks the user once). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- New screenshots as a little picture in the island (asked in the Glimmer app). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:replace="android:maxSdkVersion" />

    <!-- Lets the app ask once not to be put to sleep, so its service survives standby. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Glimmer Drop: two phones held together find each other (Bluetooth beacon) and share
         over a fast direct connection (Bluetooth and Wi-Fi Direct). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />

    <application>
        <!-- Glimmer Drop: hold two phones together and share; also in Android's share sheet. -->
        <activity
            android:name=".DropActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Glimmer Drop"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GlimmerActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The island over every app, the Face ID moment, lock screen notifications. -->
        <service
            android:name=".system.GlimmerService"
            android:exported="true"
            android:label="@string/glimmer_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/glimmer_service" />
        </service>

        <!-- Hearth asks Glimmer through this (signature-protected). -->
        <provider
            android:name=".system.GlimmerBridgeProvider"
            android:authorities="dev.hearth.glimmer.bridge"
            android:exported="true"
            android:permission="dev.hearth.permission.BRIDGE" />
    </application>
</manifest>
