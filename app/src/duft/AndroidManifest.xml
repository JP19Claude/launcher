<?xml version="1.0" encoding="utf-8"?>
<!-- Duftschrank: Clawd's perfume advisor as an app of its own – your perfumes (written down or
     photographed), which ones you like, and every day the one for the weather, with a widget for
     any launcher. The code is the one built into ZENITH; this app leaves out the rest of the family. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- What the launcher family asks for and a perfume app has no use for. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" tools:node="remove" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.NFC" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH" tools:node="remove" />

    <application>
        <!-- The shelf is this app's screen. -->
        <activity
            android:name=".PerfumeActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            tools:replace="android:exported,android:label">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Today's perfume on the home screen of any launcher. -->
        <receiver
            android:name=".duft.PerfumeAppWidget"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="dev.hearth.perfume.REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/duft_widget_info" />
        </receiver>

        <!-- Not needed here: notification access and Shizuku belong to the launcher. -->
        <service android:name=".system.MediaListenerService" tools:node="remove" />
        <provider android:name="rikka.shizuku.ShizukuProvider" tools:node="remove" />
    </application>
</manifest>
