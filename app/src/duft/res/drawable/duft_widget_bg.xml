<?xml version="1.0" encoding="utf-8"?>
<!-- Dark glass with a green rim, as close to ZENITH's look as another launcher's widget gets. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF2FD27A" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#F2101A16" />
            <corners android:radius="22.5dp" />
        </shape>
    </item>
</layer-list>
